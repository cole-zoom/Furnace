# ---------------------------------------------------------------------------
# Furnace :: local environment.  This file is gitignored — never commit it.
# ---------------------------------------------------------------------------

# -- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — must never be prefixed NEXT_PUBLIC_.
# Supabase dashboard -> Project Settings -> API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# -- Google OAuth (Calendar) ------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -- Gemini -----------------------------------------------------------------
# aistudio.google.com/apikey  (free tier is plenty for this)
GEMINI_API_KEY=

# -- App --------------------------------------------------------------------
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
# Regenerate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated. Second gate in front of the database allowlist.
ALLOWED_EMAILS=you@example.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000
